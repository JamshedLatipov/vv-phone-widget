<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:Views="clr-namespace:OrbitalSIP.Views"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:OrbitalSIP.Services"
             x:Class="OrbitalSIP.Views.ActiveCallView">
  <Border Width="320" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
    <Grid RowDefinitions="*,Auto">
      <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,0,14">

        <Views:TopBarControl Name="TopBar" Margin="0,0,0,12" />

        <StackPanel Margin="18,0,18,0" Spacing="14">
          <StackPanel HorizontalAlignment="Center" Spacing="10">


            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <TextBlock Name="CallerLabel" Text="" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" TextAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <TextBlock Name="CallerNumberLabel" Text="" FontSize="14" FontWeight="Medium" Foreground="#8FA6BE" VerticalAlignment="Center" />
                <Button Name="CopyCallerBtn" Width="22" Height="22" CornerRadius="11" Padding="0" Background="#1E293B" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center">
                  <materialIcons:MaterialIcon Kind="ContentCopy" Width="12" Height="12" Foreground="#E2E8F0" />
                </Button>
              </StackPanel>



              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Ellipse Name="StatusDot" Width="8" Height="8" Fill="#3B82F6" VerticalAlignment="Center" />
                <TextBlock Name="StatusLabel" Text="{i18n:I18n InCall}" FontSize="11" FontWeight="Bold" LetterSpacing="1.4" Foreground="#60A5FA" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <Border Background="#020617" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="16" Padding="18,14">
            <Grid ColumnDefinitions="*,Auto,*">
              <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Center">
                <TextBlock Name="TimerMinutesLabel" Text="00" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                <TextBlock Text="{i18n:I18n Minutes}" FontSize="8" FontWeight="Bold" LetterSpacing="1.5" Foreground="#6E859D" HorizontalAlignment="Center" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text=":" FontSize="20" FontWeight="Bold" Foreground="#60748A" VerticalAlignment="Center" Margin="8,0" />
              <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
                <TextBlock Name="TimerSecondsLabel" Text="00" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                <TextBlock Text="{i18n:I18n Seconds}" FontSize="8" FontWeight="Bold" LetterSpacing="1.5" Foreground="#6E859D" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>




          <UniformGrid Columns="4" Rows="1" Margin="0,2,0,0">
            <Border Margin="4" Background="#1E293B" BorderThickness="0" CornerRadius="14" Padding="10,10,10,8">
              <StackPanel Spacing="8" HorizontalAlignment="Center">
                <Button Name="MuteBtn"
                        Width="42" Height="42" CornerRadius="21"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                  <materialIcons:MaterialIcon Name="MuteIcon" Kind="Microphone" Width="20" Height="20" Foreground="#DDE7F3" />
                </Button>
                <TextBlock Name="MuteLabel" Text="Mute" FontSize="10" FontWeight="Bold" Foreground="#DDE7F3" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>

            <Border Margin="4" Background="#1E293B" BorderThickness="0" CornerRadius="14" Padding="10,10,10,8">
              <StackPanel Spacing="8" HorizontalAlignment="Center">
                <Button Name="HoldBtn"
                        Width="42" Height="42" CornerRadius="21"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                  <materialIcons:MaterialIcon Name="HoldIcon" Kind="Pause" Width="20" Height="20" Foreground="#FFFFFF" />
                </Button>
                <TextBlock Name="HoldLabel" Text="{i18n:I18n Hold}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>

            <Border Margin="4" Background="#1E293B" BorderThickness="0" CornerRadius="14" Padding="10,10,10,8">
              <StackPanel Spacing="8" HorizontalAlignment="Center">
                <Button Name="KeypadBtn"
                        Width="42" Height="42" CornerRadius="21"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                  <materialIcons:MaterialIcon Kind="Dialpad" Width="20" Height="20" Foreground="#DDE7F3" />
                </Button>
                <TextBlock Text="{i18n:I18n Keypad}" FontSize="10" FontWeight="Bold" Foreground="#DDE7F3" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>

            <Border Margin="4" Background="#1E293B" BorderThickness="0" CornerRadius="14" Padding="10,10,10,8">
              <StackPanel Spacing="8" HorizontalAlignment="Center">
                <Button Name="TransferBtn"
                        Width="42" Height="42" CornerRadius="21"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                  <materialIcons:MaterialIcon Kind="Transfer" Width="20" Height="20" Foreground="#DDE7F3" />
                </Button>
                <TextBlock Text="{i18n:I18n Transfer}" FontSize="10" FontWeight="Bold" Foreground="#DDE7F3" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <Border Name="TransferPanel" IsVisible="False"
                  Background="#0F1A28" BorderBrush="#1B2B3F" BorderThickness="1"
                  CornerRadius="14" Padding="14,12" Margin="0,0,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="{i18n:I18n TransferToOperator}" FontSize="9" FontWeight="Bold"
                         LetterSpacing="1.4" Foreground="#7B92AA" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Name="TransferNumberBox"
                         Margin="0,0,8,0"
                         Background="#152132"
                         BorderBrush="#1D3050"
                         BorderThickness="1"
                         CornerRadius="10"
                         Padding="10,6"
                         FontSize="13"
                         Foreground="#F8FAFC"
                         CaretBrush="#60A5FA"
                         Watermark="{i18n:I18n OperatorNumber}" />
                <Button Name="TransferConfirmBtn"
                        Grid.Column="1"
                        Width="74" Height="34"
                        CornerRadius="10"
                        Background="#1E4270"
                        BorderThickness="0"
                        Foreground="#60A5FA"
                        FontSize="11"
                        FontWeight="Bold"
                        Content="{i18n:I18n Transfer}"
                        HorizontalContentAlignment="Center" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- In-call DTMF pad. Digit buttons are built in code (see
               ActiveCallView.Dtmf.cs) since they all share one Click handler;
               the hold hint stays XAML because it is static text. -->
          <Border Name="DtmfPanel" IsVisible="False"
                  Background="#0F1A28" BorderBrush="#1B2B3F" BorderThickness="1"
                  CornerRadius="14" Padding="14,12">
            <StackPanel Spacing="8">
              <TextBlock Name="DtmfEchoLabel" Text="" FontSize="14" FontWeight="SemiBold"
                         Foreground="#F8FAFC" HorizontalAlignment="Center" MinHeight="18" />
              <TextBlock Name="DtmfHoldHintLabel" IsVisible="False"
                         Text="{i18n:I18n DtmfHoldHint}" FontSize="11" Foreground="#F59E0B"
                         HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
              <UniformGrid Name="DtmfGrid" Columns="3" Rows="4" />
            </StackPanel>
          </Border>

          <!-- Active-lead panel. Visibility of every block below is driven from
               LeadCallPanelPresenter.SelectState — never from lead == null. -->
          <Border Name="LeadPanel" IsVisible="False"
                  Background="#0F1A28" BorderBrush="#1B2B3F" BorderThickness="1"
                  CornerRadius="14" Padding="14,12">
            <StackPanel Spacing="8">

              <TextBlock Name="LeadLoadingLabel" IsVisible="False"
                         Text="{i18n:I18n LeadPanelSearching}"
                         FontSize="11" Foreground="#7B92AA" TextWrapping="Wrap" />

              <StackPanel Name="LeadUnavailableBlock" IsVisible="False" Spacing="8">
                <TextBlock Text="{i18n:I18n LeadPanelUnavailable}"
                           FontSize="11" Foreground="#F59E0B" TextWrapping="Wrap" />
                <Button Name="LeadRetryBtn"
                        Height="30" CornerRadius="10"
                        Background="#1E4270" BorderThickness="0"
                        Foreground="#60A5FA" FontSize="11" FontWeight="Bold"
                        Padding="14,0"
                        HorizontalAlignment="Left"
                        Content="{i18n:I18n LeadPanelRetry}" />
              </StackPanel>

              <StackPanel Name="LeadCardBlock" IsVisible="False" Spacing="8">
                <TextBlock Name="LeadHeadlineLabel" Text=""
                           FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"
                           TextWrapping="Wrap" />
                <TextBlock Name="LeadSublineLabel" Text=""
                           FontSize="11" Foreground="#7B92AA" TextWrapping="Wrap" />
                <TextBlock Name="LeadOwnerLabel" Text=""
                           FontSize="11" Foreground="#8FA6BE" TextWrapping="Wrap" />

                <Button Name="LeadOpenBtn" IsVisible="False"
                        Height="30" CornerRadius="10"
                        Background="#152132" BorderThickness="0"
                        Foreground="#60A5FA" FontSize="11" FontWeight="Bold"
                        Padding="14,0"
                        HorizontalAlignment="Left"
                        Content="{i18n:I18n LeadPanelOpen}" />

                <Button Name="LeadTransferOwnerBtn" IsVisible="False"
                        Height="34" CornerRadius="10"
                        Background="#1E4270" BorderThickness="0"
                        Foreground="#60A5FA" FontSize="11" FontWeight="Bold"
                        Padding="14,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Content="" />
                <TextBlock Name="LeadTransferBlockedLabel" IsVisible="False" Text=""
                           FontSize="10" Foreground="#7B92AA" TextWrapping="Wrap" />

                <StackPanel Name="LeadCommentBlock" IsVisible="False" Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Name="LeadCommentBox"
                             Margin="0,0,8,0"
                             Background="#152132"
                             BorderBrush="#1D3050"
                             BorderThickness="1"
                             CornerRadius="10"
                             Padding="10,6"
                             FontSize="12"
                             Foreground="#F8FAFC"
                             CaretBrush="#60A5FA"
                             AcceptsReturn="True"
                             MaxLength="4000"
                             TextWrapping="Wrap"
                             Watermark="{i18n:I18n LeadPanelComment}" />
                    <Button Name="LeadCommentAddBtn"
                            Grid.Column="1"
                            Width="74" Height="34"
                            CornerRadius="10"
                            Background="#1E4270"
                            BorderThickness="0"
                            Foreground="#60A5FA"
                            FontSize="11"
                            FontWeight="Bold"
                            Content="{i18n:I18n LeadPanelCommentAdd}"
                            VerticalAlignment="Top"
                            HorizontalContentAlignment="Center" />
                  </Grid>
                  <TextBlock Name="LeadCommentStatusLabel" IsVisible="False" Text=""
                             FontSize="10" Foreground="#7B92AA" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>

            </StackPanel>
          </Border>

          <Grid Name="CallActionsGrid" ColumnDefinitions="*,*,*,*,*,*" Margin="0,10,0,0" Height="68">
            <!-- Starts VISIBLE, matching the behaviour before this panel existed:
                 the lookup only ever takes the button away (an existing lead, or no
                 permission to create), never grants it. A widget running against a
                 CRM without the call-context route must keep working.
                 Column 0 collapses with it — see ApplyLeadPanelState — so the five
                 remaining actions (including SMS) close up instead of leaving a
                 hole on the left. -->

            <Button Grid.Column="0" Name="CreateLeadBtn"
                    Margin="0,0,2,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#1E293B"
                    BorderThickness="0"
                    CornerRadius="14"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
              <StackPanel Spacing="4" HorizontalAlignment="Center">
                <materialIcons:MaterialIcon Kind="AccountPlusOutline" Width="20" Height="20" Foreground="#60A5FA" HorizontalAlignment="Center" />
                <TextBlock Text="{i18n:I18n Lead}" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Grid.Column="1" Name="CallInfoBtn"
                    Margin="2,0,2,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#1E293B"
                    BorderThickness="0"
                    CornerRadius="14"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
              <StackPanel Spacing="4" HorizontalAlignment="Center">
                <materialIcons:MaterialIcon Kind="InformationOutline" Width="20" Height="20" Foreground="#60A5FA" HorizontalAlignment="Center" />
                <TextBlock Text="Инфо" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Grid.Column="2" Name="ScriptBtn"
                    Margin="2,0,2,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#1E293B"
                    BorderThickness="0"
                    CornerRadius="14"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
              <StackPanel Spacing="4" HorizontalAlignment="Center">
                <materialIcons:MaterialIcon Kind="ScriptTextOutline" Width="20" Height="20" Foreground="#60A5FA" HorizontalAlignment="Center" />
                <TextBlock Text="{i18n:I18n Script}" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Grid.Column="3" Name="SurveyBtn"
                    Margin="2,0,2,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#1E293B"
                    BorderThickness="0"
                    CornerRadius="14"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
              <StackPanel Spacing="4" HorizontalAlignment="Center">
                <materialIcons:MaterialIcon Kind="ClipboardListOutline" Width="20" Height="20" Foreground="#60A5FA" HorizontalAlignment="Center" />
                <TextBlock Text="Анкета" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Grid.Column="4" Name="TaskBtn"
                    Margin="2,0,2,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#1E293B"
                    BorderThickness="0"
                    CornerRadius="14"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
              <StackPanel Spacing="4" HorizontalAlignment="Center">
                <materialIcons:MaterialIcon Kind="CalendarPlus" Width="20" Height="20" Foreground="#60A5FA" HorizontalAlignment="Center" />
                <TextBlock Text="{i18n:I18n Task}" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Grid.Column="5" Name="SmsBtn"
                    Margin="2,0,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#1E293B"
                    BorderThickness="0"
                    CornerRadius="14"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
              <StackPanel Spacing="4" HorizontalAlignment="Center">
                <materialIcons:MaterialIcon Kind="MessageTextOutline" Width="20" Height="20" Foreground="#60A5FA" HorizontalAlignment="Center" />
                <TextBlock Text="{i18n:I18n Sms}" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <TextBlock Name="SmsComposeErrorLabel" IsVisible="False"
                     FontSize="11" Foreground="#FCA5A5" TextWrapping="Wrap"
                     TextAlignment="Center" Margin="4,0,4,0" />

          <!-- End call (full-width, prominent) -->
          <Button Name="HangupBtn"
                  Margin="0,8,0,0"
                  Height="52"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="#DC2626"
                  BorderThickness="0"
                  CornerRadius="14"
                  Padding="0"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <materialIcons:MaterialIcon Kind="PhoneHangup" Width="20" Height="20" Foreground="#FFFFFF" VerticalAlignment="Center" />
              <TextBlock Text="{i18n:I18n EndCall}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- ── Call Info Panel (toggled by Инфо button) ────────── -->
          <Border Name="CallInfoPanel" IsVisible="False"
                  Background="#020617" BorderBrush="#1E293B" BorderThickness="1"
                  CornerRadius="14" Padding="0" Margin="0,4,0,0">
            <StackPanel>
              <!-- Panel header -->
              <Grid ColumnDefinitions="*,Auto" Margin="14,10,14,8">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <materialIcons:MaterialIcon Kind="AccountCircleOutline" Width="16" Height="16" Foreground="#60A5FA" VerticalAlignment="Center" />
                  <TextBlock Text="Информация об абоненте" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center" />
                </StackPanel>
                <Button Name="CallInfoCloseBtn" Grid.Column="1"
                        Width="24" Height="24" CornerRadius="12"
                        Background="Transparent" BorderThickness="0"
                        Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                  <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="#6E859D" />
                </Button>
              </Grid>

              <Border Height="1" Background="#1E293B" Margin="14,0,14,10" />

              <!-- Loading -->
              <TextBlock Name="CallInfoLoadingLabel"
                         Text="Загрузка..." FontSize="12" Foreground="#6E859D"
                         HorizontalAlignment="Center" Margin="0,16,0,16" IsVisible="True" />

              <!-- Empty state -->
              <StackPanel Name="CallInfoEmptyPanel" IsVisible="False"
                          HorizontalAlignment="Center" Margin="14,8,14,14" Spacing="8">
                <materialIcons:MaterialIcon Kind="AccountOffOutline" Width="28" Height="28" Foreground="#334155" HorizontalAlignment="Center" />
                <TextBlock Text="Данные не найдены" FontSize="12" Foreground="#6E859D" HorizontalAlignment="Center" />
              </StackPanel>

              <!-- Sections (populated dynamically) -->
              <StackPanel Name="CallInfoSectionsPanel" IsVisible="False" Margin="14,0,14,14" Spacing="10" />
            </StackPanel>
          </Border>

          <TextBlock Name="TimerLabel" Text="00:00" IsVisible="False" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Views:BottomNavControl Grid.Row="1" Name="BottomNav" />
  </Grid>
  </Border>
</UserControl>
