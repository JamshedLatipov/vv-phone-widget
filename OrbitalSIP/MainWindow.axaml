<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:Views="clr-namespace:OrbitalSIP.Views"
  x:Class="OrbitalSIP.MainWindow"
  Width="96" Height="96"
  WindowStartupLocation="Manual"
  TransparencyLevelHint="Transparent"
  CanResize="False"
  Topmost="True"
  ShowInTaskbar="False"
  Background="Transparent">

  <Grid>
    <!-- Every view is laid out at its designed size and scaled as a whole, so a
         low-resolution screen does not get a widget that swallows it and a 4K one does
         not get a stamp. MainWindow keeps the window geometry in step; the scale itself
         comes from Services/WidgetScale.cs. -->
    <LayoutTransformControl Name="ScaleHost">
      <Grid>
        <ContentControl Name="Host">
          <Views:WidgetView />
        </ContentControl>
        <ContentControl Name="PopupHost"
                        Opacity="0"
                        IsVisible="False"
                        IsHitTestVisible="False"
                        ZIndex="100" />
        <ContentControl Name="OverlayHost"
                        Opacity="0"
                        IsVisible="False"
                        IsHitTestVisible="False" />
      </Grid>
    </LayoutTransformControl>

    <!-- Outside the transform on purpose. LayoutTransformControl arranges its child at
         the child's own desired size whenever that is the larger of the two, and
         WidgetView deliberately wants more room than the 96 px window so its glow can
         spill past the edge. Scaled along with it, this banner would be positioned
         against that oversized box and land outside the window — an HTTP error the
         operator never sees. It is a transient toast at a fixed 12 px, so leaving it
         unscaled costs nothing. -->
    <Border Name="HttpErrorBanner"
            IsVisible="False"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Margin="10"
            Padding="10,6"
            CornerRadius="8"
            ZIndex="200"
            Background="#CC7F1D1D"
            BorderBrush="#FFE28A8A"
            BorderThickness="1">
      <TextBlock Name="HttpErrorText"
                 Foreground="#FFFFFFFF"
                 FontSize="12"
                 TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
