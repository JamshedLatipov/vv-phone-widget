<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>false</UseWindowsForms>
    <AssemblyName>OrbitalSIP</AssemblyName>
  </PropertyGroup>

  <!-- Precompile to native code so a slow CPU is not JIT-ing Avalonia, SIPSorcery and
       the framework on every cold start. Costs ~90 MB of on-disk size and ~1 min of
       build time. Guarded on the RID because ReadyToRun is an error without one, and
       plain `dotnet build` / `dotnet test` do not set it. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- Sound files: place ring.mp3 / ring-calling.mp3 / busy.mp3 /
       call_end.mp3 / call_fail.mp3 in public/sounds and they will be
       copied to sounds/ next to the executable automatically. -->
  <ItemGroup>
    <Content Include="..\public\sounds\*.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>sounds\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Excluding NAudio.WinForms' assets drops the assembly but not the framework
       reference its nuspec declares, and that reference alone is what pulls the whole
       Windows Desktop runtime pack (WPF + WinForms) into the publish. This project's
       only transitive framework reference is that one — Microsoft.NETCore.App and the
       Windows SDK projection are both implicit — so switching them off is precise here.
       Verify with: dotnet msbuild -t:ResolvePackageAssets -getItem:FrameworkReference -->
  <PropertyGroup>
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
  </PropertyGroup>

  <!-- Ensure sounds are copied to publish output (Content alone can be skipped for self-contained single-file) -->
  <Target Name="CopySoundsAfterPublish" AfterTargets="Publish">
    <ItemGroup>
      <SoundFiles Include="..\public\sounds\*.mp3" />
    </ItemGroup>
    <Copy SourceFiles="@(SoundFiles)" DestinationFolder="$(PublishDir)sounds\" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.0" />
    <PackageReference Include="Material.Icons.Avalonia" Version="2.1.0" />
    <PackageReference Include="Sentry" Version="5.7.0" />
    <PackageReference Include="SIPSorcery" Version="10.0.13" />

    <!-- SIPSorceryMedia.Abstractions is where IAudioEncoder / MediaEndPoints /
         AudioFormat live; GainAudioEndPoint implements those interfaces directly,
         so pin it explicitly instead of inheriting whatever SIPSorcery resolves. -->
    <PackageReference Include="SIPSorceryMedia.Abstractions" Version="10.0.13" />

    <!-- SIPSorceryMedia.Windows is deliberately absent: its only type this app could
         use is WindowsAudioEndPoint, which GainAudioEndPoint already replaces, and
         from 10.0.5 onwards the package ships net10.0-windows only. Referencing the
         two NAudio assemblies directly also avoids the NAudio metapackage, whose
         NAudio.WinForms dependency was what dragged the Windows Desktop runtime pack
         (WPF + WinForms, ~50 MB) into the publish. Everything used here — WaveInEvent,
         WaveOutEvent, BufferedWaveProvider, WaveFormat, WaveBuffer, MmException —
         lives in NAudio.WinMM and NAudio.Core. -->
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />

    <!-- Pins, not real dependencies. SIPSorcery -> Makaretu.Dns.Multicast -> IPNetwork2 still
         depends on NETStandard.Library 1.6.1, which drags the 4.3.0 compatibility facades in with
         it and each of those carries an advisory. On net8.0 the implementations come from the
         shared framework, so this only moves the resolved version out of the flagged range and
         keeps the NuGet vulnerability audit clean. -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

</Project>
